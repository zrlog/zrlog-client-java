{
  "schemaVersion": 1,
  "sources": [
    {
      "id": "admin-web",
      "file": "admin-web.yaml",
      "title": "ZrLog Admin Web API",
      "version": "4.0.0",
      "sha256": "96a3b38fb7d9923a6a4be24a1fb62a7e229e4a32568f2c18d73f86354de4ce3b",
      "operations": [
        {
          "operationId": "listArticles",
          "method": "GET",
          "path": "/api/admin/article",
          "summary": "分页查询后台文章"
        },
        {
          "operationId": "getArticle",
          "method": "GET",
          "path": "/api/admin/article-edit",
          "summary": "读取完整文章快照"
        },
        {
          "operationId": "listCategories",
          "method": "GET",
          "path": "/api/admin/article-type",
          "summary": "查询全部文章分类"
        },
        {
          "operationId": "createCategory",
          "method": "POST",
          "path": "/api/admin/type/add",
          "summary": "创建文章分类"
        },
        {
          "operationId": "updateCategory",
          "method": "POST",
          "path": "/api/admin/type/update",
          "summary": "全量更新文章分类"
        },
        {
          "operationId": "createArticle",
          "method": "POST",
          "path": "/api/admin/article/create",
          "summary": "创建文章"
        },
        {
          "operationId": "updateArticle",
          "method": "POST",
          "path": "/api/admin/article/update",
          "summary": "全量更新文章"
        },
        {
          "operationId": "uploadAttachment",
          "method": "POST",
          "path": "/api/admin/upload",
          "summary": "上传通用附件"
        },
        {
          "operationId": "uploadTemplate",
          "method": "POST",
          "path": "/api/admin/template/upload",
          "summary": "上传或覆盖主题"
        },
        {
          "operationId": "createExternalNotification",
          "method": "POST",
          "path": "/api/webhook/message-center/notice",
          "summary": "发送消息中心通知"
        }
      ]
    },
    {
      "id": "blog-web",
      "file": "blog-web.yaml",
      "title": "ZrLog Blog Public API",
      "version": "4.0.0",
      "sha256": "1ad7ada0b314c9d3fc6e87daf67846506b8c7827f72b76feb3e799f8affd4444",
      "operations": [
        {
          "operationId": "listPublicArticles",
          "method": "GET",
          "path": "/api/article",
          "summary": "查询公开文章列表"
        },
        {
          "operationId": "getPublicArticle",
          "method": "GET",
          "path": "/api/article/detail",
          "summary": "查询公开文章详情"
        },
        {
          "operationId": "listPublicArticleComments",
          "method": "GET",
          "path": "/api/article/comment",
          "summary": "查询文章公开评论"
        },
        {
          "operationId": "getBlogBootstrapData",
          "method": "GET",
          "path": "/api/cache",
          "summary": "查询博客初始化缓存"
        },
        {
          "operationId": "getBlogResource",
          "method": "GET",
          "path": "/api/public/blogResource",
          "summary": "查询博客前端资源配置"
        }
      ]
    },
    {
      "id": "plugin-core",
      "file": "plugin-core.yaml",
      "title": "ZrLog Plugin Core API",
      "version": "4.0.0",
      "sha256": "f3b044619546351ff51f03e596660dd9a1f94ff15b209d55d434e906937f80e5",
      "operations": [
        {
          "operationId": "uploadPlugin",
          "method": "POST",
          "path": "/api/admin/plugins/upload",
          "summary": "上传并注册插件"
        }
      ]
    }
  ]
}
